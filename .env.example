# =====================================================================
#  club by cami — variables de entorno
# ---------------------------------------------------------------------
#  Copia este archivo como `.env.local` para desarrollo y carga las
#  mismas claves en Vercel (Project -> Settings -> Environment Variables).
#
#  IMPORTANTE SOBRE SEGURIDAD
#  Todas las variables llevan el prefijo NEXT_PUBLIC_ porque son datos
#  publicos (telefono, correo, enlaces) que se muestran en la pagina.
#  Next.js incrusta ese prefijo en el codigo que descarga el navegador,
#  asi que NUNCA pongas una clave de API, un token ni una contrasena en
#  una variable NEXT_PUBLIC_*. Si algun dia hace falta un secreto (por
#  ejemplo para enviar correos), se declara SIN ese prefijo y solo se lee
#  desde el servidor.
#
#  `.env.local` esta en .gitignore: no se sube al repositorio.
# =====================================================================

# URL canonica del sitio en produccion. Sin barra final.
# Se usa en metadatos, sitemap.xml, robots.txt y datos estructurados.
NEXT_PUBLIC_SITE_URL=https://clubdecami.com

# Numero de WhatsApp en formato internacional, CON codigo de pais y sin "+".
# Colombia = 57 + el numero de 10 digitos.
#
#   CORRECTO   573045673052
#   INCORRECTO 3045673052      <- sin el 57, wa.me abre un chat inexistente
#
# Es el error mas facil de cometer al cargar la variable en Vercel, y no da
# ningun error visible: los botones simplemente no llevan a ninguna parte.
NEXT_PUBLIC_WHATSAPP_NUMBER=573045673052

# Correo de contacto publicado en el sitio.
NEXT_PUBLIC_CONTACT_EMAIL=camila.chaconb@gmail.com

# Perfil de Instagram (URL completa https).
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/clubdecami

# Calendario de agendamiento de Google.
#  - EMBED: la URL del iframe (termina en ?gv=true)
#  - LINK : el enlace corto de respaldo, para abrir en pestana nueva
NEXT_PUBLIC_CALENDAR_EMBED_URL=https://calendar.google.com/calendar/appointments/schedules/AcZssZ2wU49tRu9IwgmXKyXBxNPcEMOmSAC_YzLgBfPAL9pFVmvmlQ6Y_HEFgIncJFdWT_wHHh_qpsCr?gv=true
NEXT_PUBLIC_CALENDAR_LINK_URL=https://calendar.app.google/cgepqveJBkL9ofUB9

# Metricas de Vercel (anonimas, sin cookies). "false" las desactiva.
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ---------------------------------------------------------------------
# Supabase — almacena las respuestas del formulario /brief (tabla `briefs`).
# ---------------------------------------------------------------------

# URL del proyecto de Supabase. Es publica (identifica el proyecto, no da
# acceso por si sola), por eso lleva el prefijo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave de servicio de Supabase (Project Settings -> API Keys -> "secret" o,
# en proyectos con claves legacy, "service_role"). Bypassa RLS: SOLO se lee
# en `src/lib/supabase/admin.ts`, en codigo de servidor (nunca en un
# componente cliente). Por eso NO lleva el prefijo NEXT_PUBLIC_ — si lo
# tuviera, Next.js la incrustaria en el bundle que descarga el navegador.
SUPABASE_SERVICE_ROLE_KEY=
